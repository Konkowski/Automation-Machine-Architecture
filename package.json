{
  "name": "automation-machine-architecture",
  "private": true,
  "version": "1.0.0",
  "description": "Builds PLC software from reusable ISA-88 blocks: a code base, machines assembled from it, exports to Studio 5000 and TIA Portal.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "node --stack-size=8000 node_modules/typescript/bin/tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:pack": "npm run build && electron-packager . --platform=win32 --arch=x64 --out=dist_electron --overwrite",
    "test": "node tests/run.mjs"
  },
  "build": {
    "appId": "com.machinestudio.app",
    "productName": "Automation Machine Architecture",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "tools/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.24",
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
